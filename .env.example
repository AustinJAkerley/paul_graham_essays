# Copy this file to ".env" and fill in the values for the backend you use.
# Do NOT commit your real .env file.

# ---- TTS backend selection ----
# One of: elevenlabs | openai
TTS_BACKEND=elevenlabs

# ---- ElevenLabs (https://elevenlabs.io) ----
# Generally regarded as the most natural-sounding AI voice software.
ELEVENLABS_API_KEY=
# Voice ID to narrate with. Use a stock voice, or a voice you are legally
# allowed to clone. See the ethics/consent note in the README.
ELEVENLABS_VOICE_ID=
# Model, e.g. eleven_multilingual_v2 or eleven_turbo_v2_5
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional voice expressiveness tuning (0.0 - 1.0).
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75

# ---- OpenAI TTS (https://platform.openai.com) ----
OPENAI_API_KEY=
# Voice, e.g. alloy, echo, fable, onyx, nova, shimmer
OPENAI_TTS_VOICE=onyx
# Model, e.g. tts-1 or tts-1-hd
OPENAI_TTS_MODEL=tts-1-hd
